digraph G{rankdir=LR;bgcolor="white";node[fontname="Helvetica",fontsize=10,shape=plaintext];edge[fontname="Helvetica",fontsize=9];
users[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1F6F8B"><font color="white"><b>users</b></font></td></tr><tr><td align="left">PK login<br align="left"/>role (facilitator|admin)<br align="left"/>salt, pin_hash (scrypt)<br align="left"/></td></tr></table>>];
act[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1F6F8B"><font color="white"><b>activities</b></font></td></tr><tr><td align="left">PK id<br align="left"/>title, topic, minutes, equipment<br align="left"/>summary, materials<br align="left"/>safety, inclusion, steps_json<br align="left"/></td></tr></table>>];
plans[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1F6F8B"><font color="white"><b>plans</b></font></td></tr><tr><td align="left">PK id (client-generated)<br align="left"/>FK activity_id (nullable)<br align="left"/>title, learning_goal, materials<br align="left"/>safety, inclusion<br align="left"/>status (draft|ready), total_minutes<br align="left"/>version, updated_at, updated_by<br align="left"/></td></tr></table>>];
steps[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1F6F8B"><font color="white"><b>plan_steps</b></font></td></tr><tr><td align="left">PK plan_id + position<br align="left"/>instruction, minutes (1-60)<br align="left"/></td></tr></table>>];
ops[label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1F6F8B"><font color="white"><b>applied_ops</b></font></td></tr><tr><td align="left">PK op_id<br align="left"/>result_json, applied_at<br align="left"/></td></tr></table>>];
act->plans[label="1 : 0..*  (based on)"];plans->steps[label="1 : 0..12  (cascade delete)"];users->plans[label="updated_by",style=dashed];plans->ops[label="op result replay",style=dashed];
}
